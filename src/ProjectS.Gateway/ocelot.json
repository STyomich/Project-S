{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/users/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "users.api", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/users/login",
      "UpstreamHttpMethod": ["OPTIONS", "POST"],

      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "DownstreamPathTemplate": "/api/users/register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "users.api", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/users/register",
      "UpstreamHttpMethod": ["POST"],

      "AuthenticationOptions": {
        "AllowAnonymous": true
      }
    },
    {
      "DownstreamPathTemplate": "/api/users/current",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "users.api", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/users/current",
      "UpstreamHttpMethod": ["GET"],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "users.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/users/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ],

      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RateLimitOptions": {
        "EnableRateLimiting": false,
        "Period": "1m",
        "Limit": 10,
        "QuotaExceededMessage": "Too many requests",
        "HttpStatusCode": 429,
        "ClientIdHeader": "Authentication"
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000",
    "RateLimitOptions": {
      "EnableRateLimiting": false,
      "Period": "1m",
      "Limit": 10,
      "QuotaExceededMessage": "Too many requests",
      "HttpStatusCode": 429,
      "ClientIdHeader": "X-Forwarded-For"
    },
    "FileCacheOptions": {
      "TtlSeconds": 30
    },
    "QoSOptions": {
      "ExceptionsAllowedBeforeBreaking": 3,
      "DurationOfBreak": 1000,
      "TimeoutValue": 5000
    },
    "RetryOptions": {
      "RetryCount": 3,
      "RetryOnServerError": true
    }
  }
}
